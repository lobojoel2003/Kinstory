# Kinstory configuration. Copy to .env for local development; in Docker,
# set these in compose.yaml or your orchestrator.

# --- Core ---------------------------------------------------------------
DATABASE_URL=postgres://kinstory:kinstory@localhost:5432/kinstory
# Public address people and the phone gateway use to reach Kinstory.
# Needed for answer links in texts and emails, phone webhooks and book QR codes.
PUBLIC_URL=http://localhost:5173
# Where recordings, photos and rendered books are kept. Back this up.
DATA_DIR=./data
# Set to false once the family has joined; invitation links keep working.
ALLOW_SIGNUP=true
SESSION_DAYS=30
# Create the fictional demo family on start-up (demo@kinstory.local / kinstory-demo).
SEED_DEMO=false
# Run the background worker (transcription, typesetting, weekly prompts) in this process.
WORKER=true
WORKER_CONCURRENCY=2
LOG_LEVEL=info

# --- Transcription ---------------------------------------------------------
# whisper-cpp: run the whisper.cpp CLI locally (the Docker image includes it)
# http:        POST to a whisper.cpp server or any OpenAI-compatible endpoint
# fake:        canned text, for tests and demos
# none:        keep recordings, type transcripts by hand
TRANSCRIBE_PROVIDER=whisper-cpp
WHISPER_BIN=whisper-cli
WHISPER_MODEL=./models/ggml-base.bin
WHISPER_THREADS=4
# "auto" detects the language; the book's language is passed when known.
WHISPER_LANGUAGE=auto
# For TRANSCRIBE_PROVIDER=http, e.g. http://whisper:8080/inference
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Typesetting ------------------------------------------------------------
# Defaults to .tools/bin/typst (npm run setup:typst), then `typst` on PATH.
TYPST_BIN=
# Allow system fonts as fallbacks for scripts the bundled fonts don't cover.
KINSTORY_SYSTEM_FONTS=0

# --- Phone line (optional) ------------------------------------------------------
# Any TwiML-compatible gateway: Twilio, or SignalWire via TWILIO_API_BASE.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_BASE=https://api.twilio.com
VOICE_TTS_VOICE=Polly.Joanna-Neural
VOICE_TTS_LANGUAGE=en-US
VOICE_MAX_RECORDING_SECONDS=1800
VOICE_SILENCE_TIMEOUT=20

# --- Email (optional) -------------------------------------------------------------
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Kinstory <kinstory@example.com>

# --- adapter-node -------------------------------------------------------------------
# Recordings can be long: allow large uploads.
BODY_SIZE_LIMIT=300M
